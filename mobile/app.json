{
  "expo": {
    "name": "StreakFit",
    "slug": "streakfit",
    "owner": "hiroshi0301",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "streakfit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.streakfit.app"
    },
    "android": {
      "package": "com.streakfit.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#FF6A00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
